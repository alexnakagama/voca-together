{
  "@@locale": "en",
  "appTitle": "VocaTogether",
  "@appTitle": {
    "description": "The app's name, shown by Android in the recent-apps switcher."
  },
  "emailLabel": "Email",
  "@emailLabel": {
    "description": "Label of an email address text field."
  },
  "passwordLabel": "Password",
  "@passwordLabel": {
    "description": "Label of a password text field."
  },
  "showPassword": "Show password",
  "@showPassword": {
    "description": "Tooltip and accessibility label of the button that reveals the password being typed."
  },
  "hidePassword": "Hide password",
  "@hidePassword": {
    "description": "Tooltip and accessibility label of the button that hides the password being typed again."
  },
  "continueWithGoogle": "Continue with Google",
  "@continueWithGoogle": {
    "description": "Text of the Sign in with Google button. Must be one of Google's approved button texts (or its official translation)."
  },
  "errorLabel": "Error",
  "@errorLabel": {
    "description": "Accessibility label of the icon in front of a form-level error message."
  },
  "noticeLabel": "Notice",
  "@noticeLabel": {
    "description": "Accessibility label of the icon in front of a neutral notice, such as a confirmation that an email was sent."
  },
  "splashLoading": "Loading",
  "@splashLoading": {
    "description": "Accessibility label of the progress indicator shown while the app starts."
  },
  "backToLogIn": "Back to log in",
  "@backToLogIn": {
    "description": "Button that returns to the log-in screen."
  },
  "tryAgain": "Try again",
  "@tryAgain": {
    "description": "Button that repeats a request that failed."
  },
  "logInTitle": "Log in",
  "@logInTitle": {
    "description": "Title of the log-in screen."
  },
  "logInButton": "Log in",
  "@logInButton": {
    "description": "Button that submits the log-in form."
  },
  "forgotPasswordLink": "Forgot password?",
  "@forgotPasswordLink": {
    "description": "Link from the log-in screen to the screen that sends a password reset email."
  },
  "createAccountLink": "Create an account",
  "@createAccountLink": {
    "description": "Link from the log-in screen to the registration screen."
  },
  "emailNotVerifiedNotice": "Verify your email address to log in. Open the link we sent to {email}, then log in again.",
  "@emailNotVerifiedNotice": {
    "description": "Shown on the log-in screen when the password was right but the address is not verified yet. {email} is the address the user typed.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "ana@example.com"
      }
    }
  },
  "resendVerificationButton": "Send a new verification email",
  "@resendVerificationButton": {
    "description": "Button that asks for a new email address verification link."
  },
  "resendVerificationSent": "If {email} is waiting to be verified, we’ve sent a new link. It can take a few minutes to arrive.",
  "@resendVerificationSent": {
    "description": "Confirmation after asking for a new verification link. Must not say whether an account exists. {email} is the address the user typed.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "ana@example.com"
      }
    }
  },
  "registerTitle": "Create account",
  "@registerTitle": {
    "description": "Title of the registration screen."
  },
  "registerButton": "Create account",
  "@registerButton": {
    "description": "Button that submits the registration form."
  },
  "confirmPasswordLabel": "Confirm password",
  "@confirmPasswordLabel": {
    "description": "Label of the field where the user types the new password a second time."
  },
  "haveAccountLink": "Already have an account? Log in",
  "@haveAccountLink": {
    "description": "Link from the registration screen to the log-in screen."
  },
  "checkEmailTitle": "Check your email",
  "@checkEmailTitle": {
    "description": "Title shown after the registration form was accepted."
  },
  "registerSent": "We’ve sent a message to {email} with the next steps. Open it to finish setting up your account, then log in.",
  "@registerSent": {
    "description": "Shown after the registration form was accepted. Must not say whether a new account was created. {email} is the address the user typed.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "ana@example.com"
      }
    }
  },
  "forgotPasswordTitle": "Reset your password",
  "@forgotPasswordTitle": {
    "description": "Title of the screen that sends a password reset email."
  },
  "forgotPasswordIntro": "Enter the email address you use for VocaTogether and we’ll send you an email with the next steps.",
  "@forgotPasswordIntro": {
    "description": "Explanation at the top of the password reset request screen."
  },
  "forgotPasswordButton": "Send reset link",
  "@forgotPasswordButton": {
    "description": "Button that asks for a password reset email."
  },
  "forgotPasswordSent": "If there’s a VocaTogether account for {email}, we’ve sent it an email with the next steps. Open the link in that email to choose a new password, then log in here.",
  "@forgotPasswordSent": {
    "description": "Shown after a password reset was requested. Must read the same whether or not the account exists. {email} is the address the user typed.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "ana@example.com"
      }
    }
  },
  "homeLoading": "Loading your account",
  "@homeLoading": {
    "description": "Accessibility label of the progress indicator while the signed-in account loads."
  },
  "homeSignedInTitle": "You’re signed in",
  "@homeSignedInTitle": {
    "description": "Heading of the home screen once the account has loaded."
  },
  "homeSignedInAs": "Signed in as {email}",
  "@homeSignedInAs": {
    "description": "The signed-in account’s email address on the home screen.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "ana@example.com"
      }
    }
  },
  "homeMemberSince": "Member since {date}",
  "@homeMemberSince": {
    "description": "When the account was created, on the home screen.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMMd"
      }
    }
  },
  "logOutButton": "Log out",
  "@logOutButton": {
    "description": "Button that signs the user out."
  },
  "emailRequired": "Enter your email address",
  "@emailRequired": {
    "description": "Field error when the email field was left empty."
  },
  "passwordRequired": "Enter your password",
  "@passwordRequired": {
    "description": "Field error when the password field was left empty."
  },
  "confirmPasswordRequired": "Enter your password again",
  "@confirmPasswordRequired": {
    "description": "Field error when the password confirmation field was left empty."
  },
  "passwordsDoNotMatch": "The passwords don’t match",
  "@passwordsDoNotMatch": {
    "description": "Field error when the confirmation differs from the password."
  },
  "errorEmailInvalid": "Enter a valid email address",
  "@errorEmailInvalid": {
    "description": "Field error when the server refused the email address."
  },
  "errorPasswordTooShort": "This password is too short. Choose a longer one.",
  "@errorPasswordTooShort": {
    "description": "Field error when the server refused a new password as too short. Gives no number on purpose: the rule belongs to the server."
  },
  "errorPasswordTooLong": "This password is too long. Choose a shorter one.",
  "@errorPasswordTooLong": {
    "description": "Field error when the server refused a new password as too long. Gives no number on purpose."
  },
  "errorPasswordTooCommon": "This password is too common. Choose one that’s harder to guess.",
  "@errorPasswordTooCommon": {
    "description": "Field error when the server refused a new password as too common."
  },
  "errorPasswordSameAsEmail": "Your password can’t be your email address.",
  "@errorPasswordSameAsEmail": {
    "description": "Field error when the new password equals the email address."
  },
  "errorCheckInput": "Check the details you entered and try again.",
  "@errorCheckInput": {
    "description": "Form error when the server refused the input for a reason the app cannot show on a field."
  },
  "errorInvalidCredentials": "Incorrect email or password.",
  "@errorInvalidCredentials": {
    "description": "Form error when logging in failed. Must not say which of the two was wrong."
  },
  "errorEmailNotVerified": "Verify your email address before logging in.",
  "@errorEmailNotVerified": {
    "description": "Form error when an unverified account tries to log in."
  },
  "errorRateLimited": "Too many attempts. Try again in {wait}.",
  "@errorRateLimited": {
    "description": "Form error when the server limits requests. {wait} is a duration such as \"2 minutes\".",
    "placeholders": {
      "wait": {
        "type": "String",
        "example": "2 minutes"
      }
    }
  },
  "errorRateLimitedNoWait": "Too many attempts. Please wait a moment and try again.",
  "@errorRateLimitedNoWait": {
    "description": "Form error when the server limits requests and gives no waiting time."
  },
  "errorUnavailable": "VocaTogether is busy right now. Try again in {wait}.",
  "@errorUnavailable": {
    "description": "Form error when the server is temporarily overloaded. {wait} is a duration such as \"5 seconds\".",
    "placeholders": {
      "wait": {
        "type": "String",
        "example": "2 minutes"
      }
    }
  },
  "errorUnavailableNoWait": "VocaTogether is busy right now. Please try again in a moment.",
  "@errorUnavailableNoWait": {
    "description": "Form error when the server is temporarily overloaded and gives no waiting time."
  },
  "errorSessionInvalid": "We couldn’t confirm your session. Try again.",
  "@errorSessionInvalid": {
    "description": "Error on a signed-in screen when the server refused the session."
  },
  "errorUnexpected": "Something went wrong on our side. Please try again.",
  "@errorUnexpected": {
    "description": "Generic error for server failures and unexpected responses."
  },
  "errorNetwork": "Couldn’t connect. Check your internet connection and try again.",
  "@errorNetwork": {
    "description": "Error when the server could not be reached."
  },
  "errorTimeout": "The connection timed out. Check your internet connection and try again.",
  "@errorTimeout": {
    "description": "Error when the server took too long to answer."
  },
  "waitSeconds": "{count, plural, =1{1 second} other{{count} seconds}}",
  "@waitSeconds": {
    "description": "A waiting time in seconds, used inside error messages.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "waitMinutes": "{count, plural, =1{1 minute} other{{count} minutes}}",
  "@waitMinutes": {
    "description": "A waiting time in minutes, used inside error messages.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "waitHours": "{count, plural, =1{1 hour} other{{count} hours}}",
  "@waitHours": {
    "description": "A waiting time in hours, used inside error messages.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  }
}
