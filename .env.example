# Application
ENV=development
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://voca:voca@localhost:5432/voca?sslmode=disable

# Proxy
TRUSTED_PROXY_HOPS=0

# Email — Resend
# Leave empty in local development if using LogSender
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Google Sign-In
# OAuth client ID used by the backend to validate the Google ID token audience.
# This is NOT a secret.
GOOGLE_CLIENT_ID=