# Application
ENV=development
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://voca:voca@localhost:5432/voca?sslmode=disable

# Proxy
TRUSTED_PROXY_HOPS=0

# Email — Resend
# Leave empty in local development if using LogSender
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Google Sign-In
# The Web application OAuth client ID (the Android app passes it as serverClientId).
# The backend accepts only Google ID tokens whose aud is exactly this value.
# Public, not a secret. It must end in .apps.googleusercontent.com; no spaces.
# production: required (startup fails without it). development: optional, empty
# disables Google sign-in (every attempt gets 401). test: ignored.
# No client secret is used or needed: never put one here.
# Example: 123456789012-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=